# Build stage
FROM --platform=linux/amd64 golang:1.23 AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the Lambda function
RUN CGO_ENABLED=0 GOOS=linux go build -o bootstrap ./cmd/lambda/main.go

# Runtime stage
FROM --platform=linux/amd64 public.ecr.aws/lambda/go:1

# Copy the binary from builder stage
COPY --from=builder /app/bootstrap ./

# Command to run
CMD ["bootstrap"]